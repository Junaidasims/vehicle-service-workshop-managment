<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Service_Date_Newer</name>
        <label>Is Service Date Newer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Date Not Newer — Skip</defaultConnectorLabel>
        <rules>
            <name>No_Last_Service_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Vehiclee.Last_Service_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Vehiclee_Last_Service_Date</targetReference>
            </connector>
            <label>Vehicle Has No Last Service Date</label>
        </rules>
        <rules>
            <name>Service_Date_Is_More_Recent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Service_Date__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Vehiclee.Last_Service_Date__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Vehiclee_Last_Service_Date</targetReference>
            </connector>
            <label>Service Date Is More Recent</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Vehiclee Last Service Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Vehiclee Last Service Date Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Vehiclee</name>
        <label>Get Vehiclee</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Service_Date_Newer</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehiclee__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehiclee__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Vehiclee_Last_Service_Date</name>
        <label>Update Vehiclee Last Service Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehiclee__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Service_Date__c</field>
            <value>
                <elementReference>$Record.Service_Date__c</elementReference>
            </value>
        </inputAssignments>
        <object>Vehiclee__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Vehiclee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Service_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Vehiclee__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Service_Orderr__c</object>
