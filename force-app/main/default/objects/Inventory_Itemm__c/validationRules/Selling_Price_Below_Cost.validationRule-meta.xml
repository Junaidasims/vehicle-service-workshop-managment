<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Selling_Price_Below_Cost</fullName>
    <active>true</active>
    <errorConditionFormula>Selling_Price__c &lt; Unit_Cost__c</errorConditionFormula>
    <errorDisplayField>Selling_Price__c</errorDisplayField>
    <errorMessage>Selling price cannot be lower than unit cost</errorMessage>
</ValidationRule>
