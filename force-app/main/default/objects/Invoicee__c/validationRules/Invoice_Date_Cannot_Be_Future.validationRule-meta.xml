<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invoice_Date_Cannot_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Invoice_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Invoice_Date__c</errorDisplayField>
    <errorMessage>Invoice Date cannot be in future</errorMessage>
</ValidationRule>
