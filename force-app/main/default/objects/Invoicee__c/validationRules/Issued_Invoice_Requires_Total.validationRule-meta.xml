<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Issued_Invoice_Requires_Total</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Invoice_Status__c, &quot;Issued&quot;),
    OR(
        ISBLANK(Total_Amount__c),
        Total_Amount__c &lt; 0
    )
)</errorConditionFormula>
    <errorDisplayField>Invoice_Status__c</errorDisplayField>
    <errorMessage>An issued invoice cannot have a negative total amount</errorMessage>
</ValidationRule>
