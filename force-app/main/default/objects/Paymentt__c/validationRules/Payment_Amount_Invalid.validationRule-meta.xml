<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Amount_Invalid</fullName>
    <active>true</active>
    <errorConditionFormula>Payment_Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Payment_Amount__c</errorDisplayField>
    <errorMessage>Payment Amount must be greater than zero</errorMessage>
</ValidationRule>
