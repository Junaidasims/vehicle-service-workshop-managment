<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_Notes_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Item_Status__c, &quot;Cancelled&quot;),
    ISBLANK(Notes__c)
)</errorConditionFormula>
    <errorMessage>Please provide Notes when cancelling a service item</errorMessage>
</ValidationRule>
