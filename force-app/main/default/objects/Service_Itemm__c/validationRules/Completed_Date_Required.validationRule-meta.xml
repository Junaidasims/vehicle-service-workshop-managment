<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Item_Status__c, &quot;Completed&quot;),
    ISBLANK(Completed_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage>Completed date is required when item status is completed</errorMessage>
</ValidationRule>
