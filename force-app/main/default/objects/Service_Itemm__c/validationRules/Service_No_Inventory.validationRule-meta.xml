<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Service_No_Inventory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Item_Type__c, &quot;Service&quot;),
    NOT(ISBLANK(Inventory_Itemm__c))
)</errorConditionFormula>
    <errorDisplayField>Inventory_Itemm__c</errorDisplayField>
    <errorMessage>A Service item cannot be linked to an Inventory Item</errorMessage>
</ValidationRule>
