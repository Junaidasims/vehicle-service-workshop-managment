<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approved_Status_Requires_Customer_Approv</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Service_Status__c, &quot;Approved&quot;),
    NOT(ISPICKVAL(Customer_Approval__c, &quot;Approved&quot;))
)</errorConditionFormula>
    <errorDisplayField>Service_Status__c</errorDisplayField>
    <errorMessage>Service order cannot be marked Approved until Customer Approval is received</errorMessage>
</ValidationRule>
