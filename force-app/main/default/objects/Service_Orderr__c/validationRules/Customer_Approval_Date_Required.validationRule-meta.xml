<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Approval_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Customer_Approval__c, &quot;Approved&quot;),
    ISBLANK(Customer_Approval_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Customer_Approval_Date__c</errorDisplayField>
    <errorMessage>Customer Approval date is required when customer approval is approved</errorMessage>
</ValidationRule>
