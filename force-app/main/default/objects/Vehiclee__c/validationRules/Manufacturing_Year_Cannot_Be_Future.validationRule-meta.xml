<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manufacturing_Year_Cannot_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Manufacturing_Year__c &gt; YEAR(TODAY())</errorConditionFormula>
    <errorDisplayField>Manufacturing_Year__c</errorDisplayField>
    <errorMessage>Manufacturing Year cannot be greater than the current year</errorMessage>
</ValidationRule>
