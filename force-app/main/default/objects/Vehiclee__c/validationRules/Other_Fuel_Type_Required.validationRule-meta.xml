<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Fuel_Type_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Fuel_Type__c, &quot;Other&quot;),
    ISBLANK(Other_Fuel_Type__c)
)</errorConditionFormula>
    <errorDisplayField>Other_Fuel_Type__c</errorDisplayField>
    <errorMessage>Please enter the Other Fuel Type</errorMessage>
</ValidationRule>
