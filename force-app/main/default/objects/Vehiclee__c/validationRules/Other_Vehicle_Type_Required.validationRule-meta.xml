<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Vehicle_Type_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL( Vehicle_Type__c, &quot;Other&quot;),
    ISBLANK( Other_Vehicle_Type__c)
)</errorConditionFormula>
    <errorDisplayField>Other_Vehicle_Type__c</errorDisplayField>
    <errorMessage>Please enter the other Vehicle Type</errorMessage>
</ValidationRule>
