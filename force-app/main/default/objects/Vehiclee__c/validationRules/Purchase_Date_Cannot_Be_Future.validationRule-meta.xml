<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Purchase_Date_Cannot_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Purchase_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Purchase_Date__c</errorDisplayField>
    <errorMessage>Purchase Date cannot be in the future</errorMessage>
</ValidationRule>
