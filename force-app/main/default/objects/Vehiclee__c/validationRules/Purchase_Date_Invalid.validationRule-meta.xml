<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Purchase_Date_Invalid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Purchase_Date__c)),
    YEAR(Purchase_Date__c) &lt; Manufacturing_Year__c
)</errorConditionFormula>
    <errorDisplayField>Purchase_Date__c</errorDisplayField>
    <errorMessage>Purchase date cannot be earlier than vehicle&apos;s manufacturing year</errorMessage>
</ValidationRule>
